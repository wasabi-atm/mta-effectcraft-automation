# ImageKit (same account as loom-gif-automation). Only `sneakpeek host` needs these.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/motiontheagency
IMAGEKIT_PRIVATE_KEY=
SNEAKPEEK_IMAGEKIT_FOLDER=/outreach/sneakpeek-gif

# Optional overrides (defaults: .tools/bin/effectcraft-cli and .venv/bin/python)
# EFFECTCRAFT_CLI=/usr/bin/effectcraft-cli
# BLENDER_PYTHON=/path/to/python-with-bpy
